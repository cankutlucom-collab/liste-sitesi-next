# Bu dosyayı .env.local olarak kopyalayın ve değerleri değiştirin. .env.local paylaşılmamalıdır.

# Zorunlu: yönetim paneli şifresi (en az 12 karakter). Tanımlı değilse /admin kapalı kalır.
ADMIN_PASSWORD=

# İsteğe bağlı: oturum imzalama anahtarı (en az 32 karakter). Boşsa şifreden türetilir.
ADMIN_SESSION_SECRET=

# İsteğe bağlı: önünüzdeki GÜVENİLİR ters proxy sayısı (varsayılan 0). Yerel önizlemede boş bırakın.
# 0 iken X-Forwarded-For'a hiç güvenilmez; tüm giriş denemeleri tek ortak sayacı paylaşır.
# 1+ yalnızca uygulama portuna doğrudan erişim kapalıysa (ör. 127.0.0.1'e bağlı, güvenlik duvarı)
# ve her proxy bağlantı adresini X-Forwarded-For'a EKLİYORSA ayarlayın (nginx: $proxy_add_x_forwarded_for).
# Ayrıntı: README "Giriş denemesi sınırı".
# ADMIN_TRUSTED_PROXY_HOPS=0

# İsteğe bağlı: SQLite dosya yolu. Varsayılan: ./data/liste.sqlite
# LISTE_DB_PATH=
