    ".verification-panel-fix/dev/types/**/*.ts",
    ".verification-panel-stage1/types/**/*.ts",
    ".verification-panel-stage1/dev/types/**/*.ts",
    ".verification-panel-description/types/**/*.ts",
    ".verification-panel-description/dev/types/**/*.ts",
    ".verification-panel-login/types/**/*.ts",
