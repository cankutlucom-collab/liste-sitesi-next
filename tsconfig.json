{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "**/*.ts",
    "**/*.tsx",
    ".verification-menu/types/**/*.ts",
    ".verification-menu/dev/types/**/*.ts",
    ".verification-menu-fixed/types/**/*.ts",
    ".verification-menu-fixed/dev/types/**/*.ts",
    ".verification-complaint-order/types/**/*.ts",
    ".verification-complaint-order/dev/types/**/*.ts",
    ".verification-ankara/types/**/*.ts",
    ".verification-ankara/dev/types/**/*.ts",
    ".verification-ankara-template/types/**/*.ts",
    ".verification-ankara-template/dev/types/**/*.ts",
    ".verification-panel/types/**/*.ts",
    ".verification-panel/dev/types/**/*.ts",
