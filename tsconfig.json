    ".verification-list-4172ac18/types/**/*.ts",
    ".verification-list-4172ac18/dev/types/**/*.ts",
    ".verification-audit-fixes/types/**/*.ts",
    ".verification-audit-fixes/dev/types/**/*.ts",
    ".verification-form-design/types/**/*.ts",
    ".verification-form-design/dev/types/**/*.ts",
    ".verification-throttle/types/**/*.ts",
    ".verification-throttle/dev/types/**/*.ts",
